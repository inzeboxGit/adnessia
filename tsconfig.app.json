{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/project-core/composables/**/*",
    "src/project-core/stores/**/*",
    "src/project-core/services/agences.ts",
    "src/project-core/services/customers.ts",
    "src/project-core/services/incidents.ts",
    "src/project-core/services/listings.ts",
    "src/project-core/services/reviews.ts",
    "src/project-core/services/superadmins.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/project-core/*"]
    }
  }
}
